{
    "name": "campusbook-theme",
    "version": "1.0.0",
    "description": "Custom Keycloak theme inspired by Campusbook",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme": "npm run build && keycloakify build",
        "build-and-deploy": "npm run build-keycloak-theme && mkdir -p ../themes/campusbook-theme && unzip -q -o dist_keycloak/keycloak-theme-for-kc-all-other-versions.jar 'theme/campusbook-theme/*' -d /tmp/cb_theme && cp -r /tmp/cb_theme/theme/campusbook-theme/* ../themes/campusbook-theme/ && rm -rf /tmp/cb_theme",
        "storybook": "storybook dev -p 6006",
        "format": "prettier . --write"
    },
    "license": "MIT",
    "dependencies": {
        "@radix-ui/react-slot": "^1.1.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "keycloakify": "^11.16.4",
        "lucide-react": "^1.7.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^3.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@tailwindcss/vite": "^4.0.9",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "globals": "^15.12.0",
        "prettier": "3.3.1",
        "tailwindcss": "^4.0.9",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.15.0",
        "vite": "^5.4.14"
    },
    "engines": {
        "node": "^18.0.0 || >=20.0.0"
    }
}
